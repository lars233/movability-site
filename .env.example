# ── Movability CMS configuration ─────────────────────────────────────────
# Copy these into your hosting provider's environment variables.
# In production the API refuses to start unless SESSION_SECRET and an admin
# password are set — there are no defaults.

# Signs the admin session cookie. Minimum 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Admin login. Generate the hash with:
#   node artifacts/api-server/hash-password.mjs 'your new password'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Where the CMS database and uploaded images live. On a host with a
# persistent disk, point both at that disk so they survive deploys.
CMS_DB_PATH=./database.sqlite
UPLOADS_DIR=./uploads

# Only needed if the site is served from a different domain than the API.
# Comma-separated, e.g. https://movability.io,https://www.movability.io
ALLOWED_ORIGINS=

# Absolute URL of the live site — used for canonical links, social previews
# and sitemap.xml. Set this once the custom domain is live.
SITE_URL=https://movability.io

# Email notification for contact form submissions (optional).
# Create a free key at resend.com, then set:
RESEND_API_KEY=
NOTIFY_EMAIL=lars@movability.io
# Until movability.io is verified with Resend, leave NOTIFY_FROM unset and mail
# is sent from onboarding@resend.dev, which can only deliver to your own address.
NOTIFY_FROM=
